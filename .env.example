# API key for your LLM provider
# Set the env var that your provider expects (LiteLLM reads these directly):
#   ANTHROPIC_API_KEY=sk-ant-...
#   OPENAI_API_KEY=sk-...
#   OPENROUTER_API_KEY=sk-or-...
#   GEMINI_API_KEY=...
# See https://docs.litellm.ai/docs/providers for the full list.

# Model (LiteLLM format — prefix determines provider routing)
# NOTES2LATEX_MODEL=openrouter/anthropic/claude-sonnet-4-20250514

# OpenAI-compatible endpoint override and its key, for providers LiteLLM does not
# know by name (e.g. a self-hosted proxy).
# NOTES2LATEX_API_BASE=https://example.com/proxy/v1
# NOTES2LATEX_API_KEY=sk-...

# Conversion mode: `transcribe` (faithful transcription) or `material`
# (student-facing material with a separate editorial-notes pass)
# NOTES2LATEX_MODE=transcribe

# Hack Club CDN key — when set, page images are uploaded and their URLs saved to
# cdn_urls.json. Upload failures never fail a job.
# NOTES2LATEX_CDN_API_KEY=

# Output directory (default: ./output)
# NOTES2LATEX_OUTPUT_DIR=./output
